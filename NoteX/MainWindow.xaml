<Window x:Class="NoteX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:NoteX.Converters"
        xmlns:vm="clr-namespace:NoteX.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="650" Width="950"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{Binding Settings.FontFamily}"
        Icon="pack://application:,,,/Resources/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
        <conv:TextWrappingConverter x:Key="TextWrapConv"/>
        <conv:ScrollBarVisibilityConverter x:Key="HScrollConv"/>
        <conv:ZoomToScaleConverter x:Key="ZoomConv"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDocumentCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDocumentCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveDocumentCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsDocumentCommand}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding AddNewPageCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding ClosePageCommand}" CommandParameter="{Binding SelectedPage}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding ShowFindCommand}"/>
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding ShowReplaceCommand}"/>
        <KeyBinding Key="F3" Command="{Binding FindNextCommand}"/>
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding FindPreviousCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ResetZoomCommand}"/>
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ResetZoomCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- メニューバー -->
            <RowDefinition Height="Auto"/> <!-- タブバー -->
            <RowDefinition Height="Auto"/> <!-- 検索・置換バー -->
            <RowDefinition Height="*"/>    <!-- エディタ本体 -->
            <RowDefinition Height="Auto"/> <!-- ステータスバー -->
        </Grid.RowDefinitions>

        <!-- メニューバー -->
        <Menu Grid.Row="0" Margin="4,2,4,2">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規ファイル(_N)" InputGestureText="Ctrl+N" Command="{Binding NewDocumentCommand}"/>
                <MenuItem Header="開く(_O)..." InputGestureText="Ctrl+O" Command="{Binding OpenDocumentCommand}"/>
                <Separator/>
                <MenuItem Header="上書き保存(_S)" InputGestureText="Ctrl+S" Command="{Binding SaveDocumentCommand}"/>
                <MenuItem Header="名前を付けて保存(_A)..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsDocumentCommand}"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Click="MenuExit_Click"/>
            </MenuItem>

            <MenuItem Header="ページ(_P)">
                <MenuItem Header="新規ページを追加(_N)" InputGestureText="Ctrl+T" Command="{Binding AddNewPageCommand}"/>
                <MenuItem Header="現在のページを閉じる(_W)" InputGestureText="Ctrl+W" Command="{Binding ClosePageCommand}" CommandParameter="{Binding SelectedPage}"/>
                <MenuItem Header="ページ名を変更(_R)..." InputGestureText="F2" Command="{Binding RenamePageCommand}" CommandParameter="{Binding SelectedPage}"/>
                <MenuItem Header="ページを複製(_D)" Command="{Binding DuplicatePageCommand}" CommandParameter="{Binding SelectedPage}"/>
                <Separator/>
                <MenuItem Header="左へ移動" Command="{Binding MovePageLeftCommand}" CommandParameter="{Binding SelectedPage}"/>
                <MenuItem Header="右へ移動" Command="{Binding MovePageRightCommand}" CommandParameter="{Binding SelectedPage}"/>
            </MenuItem>

            <MenuItem Header="変換・エクスポート(_T)">
                <MenuItem Header="全ページを個別の .txt として一括出力(_E)..." Command="{Binding ExportAllPagesToTxtCommand}"/>
                <MenuItem Header="現在のページを .txt として出力(_C)..." Command="{Binding ExportCurrentPageToTxtCommand}"/>
                <MenuItem Header="全ページを1つの .txt に結合して出力(_M)..." Command="{Binding ExportMergedTxtCommand}"/>
                <Separator/>
                <MenuItem Header="テキストファイル (.txt) をページとして取り込み(_I)..." Command="{Binding ImportTxtFilesCommand}"/>
                <MenuItem Header="フォルダ内の全 .txt を一括取り込み(_D)..." Command="{Binding ImportTxtDirectoryCommand}"/>
            </MenuItem>

            <MenuItem Header="編集(_E)">
                <MenuItem Header="元に戻す(_U)" InputGestureText="Ctrl+Z" Click="MenuUndo_Click"/>
                <MenuItem Header="やり直し(_R)" InputGestureText="Ctrl+Y" Click="MenuRedo_Click"/>
                <Separator/>
                <MenuItem Header="切り取り(_T)" InputGestureText="Ctrl+X" Click="MenuCut_Click"/>
                <MenuItem Header="コピー(_C)" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
                <MenuItem Header="貼り付け(_P)" InputGestureText="Ctrl+V" Click="MenuPaste_Click"/>
                <MenuItem Header="すべて選択(_A)" InputGestureText="Ctrl+A" Click="MenuSelectAll_Click"/>
                <Separator/>
                <MenuItem Header="検索(_F)..." InputGestureText="Ctrl+F" Command="{Binding ShowFindCommand}"/>
                <MenuItem Header="置換(_H)..." InputGestureText="Ctrl+H" Command="{Binding ShowReplaceCommand}"/>
                <MenuItem Header="次を検索" InputGestureText="F3" Command="{Binding FindNextCommand}"/>
                <MenuItem Header="前を検索" InputGestureText="Shift+F3" Command="{Binding FindPreviousCommand}"/>
                <Separator/>
                <MenuItem Header="日付と時刻(_D)" InputGestureText="F5" Click="MenuInsertDateTime_Click"/>
            </MenuItem>

            <MenuItem Header="表示(_V)">
                <MenuItem Header="ズーム(_Z)">
                    <MenuItem Header="拡大" InputGestureText="Ctrl++" Command="{Binding ZoomInCommand}"/>
                    <MenuItem Header="縮小" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}"/>
                    <MenuItem Header="既定の倍率に戻す" InputGestureText="Ctrl+0" Command="{Binding ResetZoomCommand}"/>
                </MenuItem>
                <MenuItem Header="右端で折り返す(_W)" IsCheckable="True" IsChecked="{Binding Settings.WordWrap, Mode=OneWay}" Command="{Binding ToggleWordWrapCommand}"/>
                <MenuItem Header="行番号を表示(_L)" IsCheckable="True" IsChecked="{Binding Settings.ShowLineNumbers, Mode=OneWay}" Command="{Binding ToggleLineNumbersCommand}"/>
            </MenuItem>

            <MenuItem Header="設定(_S)">
                <MenuItem Header="環境設定(_O)..." Command="{Binding OpenSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="NoteX について(_A)" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- タブバー (複数ページ管理) -->
        <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,4,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- タブリスト -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <ListBox x:Name="PageTabsListBox"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource PageTabItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PageViewModel}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                    <!-- 未保存マーク -->
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0"
                                             Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"/>

                                    <!-- ページ名 -->
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               MouseLeftButtonDown="TabTitle_MouseLeftButtonDown"/>

                                    <!-- 閉じるボタン -->
                                    <Button Style="{StaticResource IconButton}" Width="18" Height="18" Padding="0"
                                            ToolTip="ページを閉じる (Ctrl+W)"
                                            Command="{Binding DataContext.ClosePageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="✕" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- コンテキストメニュー -->
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="名前を変更..." Command="{Binding DataContext.RenamePageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="このページを複製" Command="{Binding DataContext.DuplicatePageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="左へ移動" Command="{Binding DataContext.MovePageLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="右へ移動" Command="{Binding DataContext.MovePageRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="このページをテキスト保存..." Command="{Binding DataContext.ExportCurrentPageToTxtCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="ページを閉じる" Command="{Binding DataContext.ClosePageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- 新規タブ追加ボタン -->
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="6,0,0,2"
                        ToolTip="新しいページを追加 (Ctrl+T)"
                        Command="{Binding AddNewPageCommand}">
                    <TextBlock Text="＋" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- インライン 検索・置換バー -->
        <Border Grid.Row="2" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                Visibility="{Binding IsFindReplaceVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 検索行 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="検索:" VerticalAlignment="Center" Width="45" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBox x:Name="FindInputBox" Width="220" Height="26" VerticalContentAlignment="Center" Padding="4,0"
                             Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource EditorBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderBrush="{DynamicResource ControlBorderBrush}"
                             KeyDown="FindInputBox_KeyDown"/>

                    <Button Content="↓ 次へ (F3)" Height="26" Padding="8,0" Margin="6,0,0,0"
                            Style="{StaticResource FluentButtonStyle}" Command="{Binding FindNextCommand}"/>
                    <Button Content="↑ 前へ (Shift+F3)" Height="26" Padding="8,0" Margin="4,0,0,0"
                            Style="{StaticResource FluentButtonStyle}" Command="{Binding FindPreviousCommand}"/>

                    <CheckBox Content="大文字/小文字を区別" VerticalAlignment="Center" Margin="12,0,0,0"
                              IsChecked="{Binding MatchCase}" Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Margin="16,0,0,0"
                            ToolTip="閉じる (Esc)" Command="{Binding CloseFindReplaceCommand}">
                        <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- 置換行 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="置換:" VerticalAlignment="Center" Width="45" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBox x:Name="ReplaceInputBox" Width="220" Height="26" VerticalContentAlignment="Center" Padding="4,0"
                             Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource EditorBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderBrush="{DynamicResource ControlBorderBrush}"/>

                    <Button Content="置換" Height="26" Padding="10,0" Margin="6,0,0,0"
                            Style="{StaticResource FluentButtonStyle}" Command="{Binding ReplaceNextCommand}"/>
                    <Button Content="すべて置換" Height="26" Padding="10,0" Margin="4,0,0,0"
                            Style="{StaticResource FluentButtonStyle}" Command="{Binding ReplaceAllCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- メイン エディタ領域 -->
        <Grid Grid.Row="3" Background="{DynamicResource EditorBackgroundBrush}">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Settings.ZoomLevel, Converter={StaticResource ZoomConv}}"
                                ScaleY="{Binding Settings.ZoomLevel, Converter={StaticResource ZoomConv}}"/>
            </Grid.LayoutTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- 行番号マージン -->
                <ColumnDefinition Width="*"/>    <!-- テキストエリア -->
            </Grid.ColumnDefinitions>

            <!-- 行番号マージン -->
            <Border Grid.Column="0"
                    Visibility="{Binding Settings.ShowLineNumbers, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,0,1,0"
                    MinWidth="45"
                    Padding="8,6,8,6">
                <ScrollViewer x:Name="LineNumberScrollViewer"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <TextBlock x:Name="LineNumberTextBlock"
                               Text="1"
                               Foreground="{DynamicResource LineNumberBrush}"
                               FontFamily="{Binding Settings.FontFamily}"
                               FontSize="{Binding Settings.FontSize}"
                               TextAlignment="Right"
                               Opacity="0.8"/>
                </ScrollViewer>
            </Border>

            <!-- テキスト入力エリア -->
            <TextBox x:Name="MainEditorTextBox"
                     Grid.Column="1"
                     Text="{Binding SelectedPage.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="{Binding Settings.WordWrap, Converter={StaticResource TextWrapConv}}"
                     HorizontalScrollBarVisibility="{Binding Settings.WordWrap, Converter={StaticResource HScrollConv}}"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     AutoWordSelection="False"
                     IsUndoEnabled="True"
                     FontFamily="{Binding Settings.FontFamily}"
                     FontSize="{Binding Settings.FontSize}"
                     Background="Transparent"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderThickness="0"
                     Padding="8,6,8,6"
                     SelectionBrush="{DynamicResource SelectionBrush}"
                     SelectionChanged="MainEditorTextBox_SelectionChanged"
                     TextChanged="MainEditorTextBox_TextChanged"
                     PreviewMouseWheel="MainEditorTextBox_PreviewMouseWheel"/>
        </Grid>

        <!-- ステータスバー -->
        <StatusBar Grid.Row="4">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock Text="{Binding StatusStatsText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock Text="{Binding PageCountText}"/>
            </StatusBarItem>

            <!-- 右側インジケータ群 -->
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusLineColText}"/>
            </StatusBarItem>
            <Separator HorizontalAlignment="Right"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusZoomText}"/>
            </StatusBarItem>
            <Separator HorizontalAlignment="Right"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusNewLineText}"/>
            </StatusBarItem>
            <Separator HorizontalAlignment="Right"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusEncodingText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
