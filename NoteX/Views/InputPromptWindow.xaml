<Window x:Class="NoteX.Views.InputPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoteX" Height="190" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Yu Gothic UI, Meiryo UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptLabel" Grid.Row="0" Text="入力してください:" Margin="0,0,0,10" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>

        <TextBox x:Name="InputTextBox" Grid.Row="1" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                 Background="{DynamicResource ControlBackgroundBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 BorderBrush="{DynamicResource ControlBorderBrush}"
                 BorderThickness="1"
                 KeyDown="InputTextBox_KeyDown"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Height="30" Margin="0,0,10,0" IsDefault="True" Click="OkButton_Click"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
            <Button x:Name="CancelButton" Content="キャンセル" Width="80" Height="30" IsCancel="True" Click="CancelButton_Click"
                    Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"/>
        </StackPanel>
    </Grid>
</Window>
