<Window x:Class="NoteX.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - NoteX" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Yu Gothic UI, Meiryo UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="NoteX 設定" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- テーマ設定 -->
                <GroupBox Header="外観" Padding="12" Margin="0,0,0,14" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource ControlBorderBrush}">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="アプリのテーマ:" VerticalAlignment="Center" Width="120"/>
                        <ComboBox x:Name="ThemeComboBox" Width="180" Height="28" SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="システム設定に従う" Tag="System"/>
                            <ComboBoxItem Content="ライト" Tag="Light"/>
                            <ComboBoxItem Content="ダーク" Tag="Dark"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <!-- フォント設定 -->
                <GroupBox Header="フォント" Padding="12" Margin="0,0,0,14" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource ControlBorderBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="フォント名:" VerticalAlignment="Center" Width="120"/>
                            <ComboBox x:Name="FontFamilyComboBox" Width="240" Height="28" SelectionChanged="FontFamilyComboBox_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="フォントサイズ:" VerticalAlignment="Center" Width="120"/>
                            <ComboBox x:Name="FontSizeComboBox" Width="100" Height="28" SelectionChanged="FontSizeComboBox_SelectionChanged">
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="11"/>
                                <ComboBoxItem Content="12"/>
                                <ComboBoxItem Content="14"/>
                                <ComboBoxItem Content="16"/>
                                <ComboBoxItem Content="18"/>
                                <ComboBoxItem Content="20"/>
                                <ComboBoxItem Content="24"/>
                            </ComboBox>
                            <TextBlock Text="pt" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 編集・表示設定 -->
                <GroupBox Header="エディタ" Padding="12" Margin="0,0,0,14" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource ControlBorderBrush}">
                    <StackPanel>
                        <CheckBox x:Name="WordWrapCheckBox" Content="右端で折り返す (ワードラップ)" Checked="Setting_Changed" Unchecked="Setting_Changed" Margin="0,0,0,8"/>
                        <CheckBox x:Name="LineNumbersCheckBox" Content="行番号を表示する" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="閉じる" Width="80" Height="30" IsDefault="True" IsCancel="True" Click="CloseButton_Click"
                    Style="{DynamicResource FluentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
